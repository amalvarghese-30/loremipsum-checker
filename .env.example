# Database Configuration
# Options: 'sqlite' (zero install, recommended) or 'mysql'
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/lorem_ipsum_checker.sqlite

# If DB_DRIVER=mysql:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lorem_ipsum_checker
DB_USER=root
DB_PASSWORD=

# Allowed CORS Origins (comma-separated, your VPS IP or domain)
APP_ALLOWED_ORIGINS=http://85.31.233.134

# PHP CLI Binary
PHP_CLI_BINARY=/usr/bin/php

# Environment
APP_ENV=production
APP_DEBUG=0
