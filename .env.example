# Database Configuration
# Primary Production: 'mysql' | Development/Testing fallback: 'sqlite'
DB_DRIVER=mysql

# MySQL Settings (Required when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lorem_ipsum_checker
DB_USER=root
DB_PASSWORD=

# SQLite Path (Used when DB_DRIVER=sqlite)
DB_SQLITE_PATH=database/lorem_ipsum_checker.sqlite

# Allowed CORS Origins (comma-separated origins allowed to access the API)
APP_ALLOWED_ORIGINS=https://lorem.stillworks.in,http://localhost

# PHP CLI Binary for background worker dispatch
PHP_CLI_BINARY=/usr/bin/php

# Node.js binary for Playwright JS rendering
NODE_BINARY=/usr/bin/node

# Environment & Debugging
APP_ENV=production
APP_DEBUG=0

# Default Scan Limits
DEFAULT_MAX_URLS=500
DEFAULT_MAX_DEPTH=3
DEFAULT_CONCURRENCY=5
DEFAULT_REQUEST_TIMEOUT=30
VERIFY_SSL=false
